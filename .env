###> mobile money (MTN MoMo + Airtel Money) — SANDBOX ###

# --- MTN MoMo (https://momodeveloper.mtn.com) ---
# 1. Créez un compte, abonnez-vous aux produits "Collections" ET "Disbursements"
#    (page Products) -> vous obtenez UNE subscription key (primary) PAR produit.
# 2. Générez un API user + API key PAR produit avec le script fourni dans le guide
#    (scripts/momo-provision.php) ou via Postman (voir guide).
MOMO_BASE_URL=https://sandbox.momodeveloper.mtn.com
MOMO_TARGET_ENVIRONMENT=sandbox
MOMO_CURRENCY=EUR
# ⚠️ En sandbox MTN n'accepte QUE la devise "EUR" quel que soit le pays réel
# (limitation connue du bac à sable, documentée par MTN). Utilisez XAF
# uniquement une fois basculé sur les identifiants de PRODUCTION.

MOMO_COLLECTION_SUBSCRIPTION_KEY=69bf7d6c4c0441d9ac76b9404e974de6
MOMO_COLLECTION_API_USER=499c55d0-0b8c-4277-8333-3bf19aa0fad1
MOMO_COLLECTION_API_KEY=f09164772e974c71b246b4027e9a7f53

MOMO_DISBURSEMENT_SUBSCRIPTION_KEY=653a3f496d5b43928b8c9ae1a44d3ca0
MOMO_DISBURSEMENT_API_USER=666eedb7-555f-4195-9865-04f99a16ce94
MOMO_DISBURSEMENT_API_KEY=4074d5bd598441a58f784fcc606bbd6e

# URL que MTN appellera en PRODUCTION (ignoré en sandbox, callbacks non livrés)
MOMO_CALLBACK_HOST=ubu.alwaysdata.net

# --- Airtel Money (https://developers.airtel.africa) ---
# 1. Inscrivez-vous, créez une "Application", ajoutez les produits Collection
#    ET Disbursement -> récupérez client_id / client_secret dans "Key Management".
# 2. Pour Disbursement uniquement : récupérez la clé publique RSA dans la
#    section "Encryption Keys" de votre application, ainsi que votre PIN marchand.
# 3. Confirmez avec Airtel que le marché Congo Brazzaville (CG) est activé pour
#    votre compte — voir l'avertissement dans AirtelMoneyGateway.php.
AIRTEL_BASE_URL=https://openapiuat.airtel.africa
AIRTEL_CLIENT_ID=
AIRTEL_CLIENT_SECRET=
AIRTEL_COUNTRY=CG
AIRTEL_CURRENCY=XAF
AIRTEL_DISBURSEMENT_PIN=
AIRTEL_DISBURSEMENT_PUBLIC_KEY=

# --- Secret HMAC déjà utilisé par PaymentController::webhook() ---
# Doit être identique à celui déjà présent dans votre .env actuel.
# TRANSITO_PAYMENT_WEBHOOK_SECRET=change-me-in-local-env

###< mobile money ###
